+/* ── Dual-range slider: ONE track (divs) + transparent inputs ── */
+.cfp-slider-track { position: relative; height: 28px; margin-bottom: 2px; }
+
+/* The only visible track: background gray bar */
+.cfp-track-bg,
+.cfp-track-active {
+  position: absolute; top: 50%; left: 0; right: 0;
+  height: 4px; border-radius: 2px;
+  transform: translateY(-50%); pointer-events: none;
+}
+.cfp-track-bg   { background: #e0e0e0; }
+.cfp-track-active { background: var(--accent, #1a73e8); }
+
+/* Both range inputs: completely transparent — divs draw the track */
+.cfp-slider-track .cfp-range {
+  position: absolute; top: 0; left: 0;
+  width: 100%; height: 28px;
+  margin: 0 !important; padding: 0 !important; border: none !important;
+  box-shadow: none !important;
+  -webkit-appearance: none; appearance: none;
+  background: transparent !important;
+  pointer-events: none;
+  outline: none !important;
+}
+/* Native track — must be invisible */
+.cfp-slider-track .cfp-range::-webkit-slider-runnable-track {
+  height: 4px;
+  background: transparent !important;
+  border: 0 !important;
+  box-shadow: none !important;
+}
+.cfp-slider-track .cfp-range::-moz-range-track {
+  height: 4px;
+  background: transparent !important;
+  border: 0 !important;
+  box-shadow: none !important;
+}
+/* Thumb — 14px circle, centered on 4px transparent native track */
+.cfp-slider-track .cfp-range::-webkit-slider-thumb {
+  -webkit-appearance: none; appearance: none;
+  width: 14px !important; height: 14px !important;
+  border-radius: 50%; border: none !important;
+  box-shadow: none !important;
+  background: var(--accent, #1a73e8) !important;
+  cursor: pointer; pointer-events: auto;
+  margin-top: -5px;
+}
+.cfp-slider-track .cfp-range::-moz-range-thumb {
+  width: 14px; height: 14px; border-radius: 50%;
+  background: var(--accent, #1a73e8); border: none; cursor: pointer; pointer-events: auto;
+}
