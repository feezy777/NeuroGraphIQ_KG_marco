+    "fetching",
+    "retrieving",
+    "extracting",
+    "verifying",
+    "awaiting_review",
+)
+
+# review 非终态状态集合(同 item 同时只能有一个当前有效 review;draft/pending 为防御性保留)
+REVIEW_NON_TERMINAL_STATUSES = ("draft", "pending", "awaiting_review", "returned")
+
 
