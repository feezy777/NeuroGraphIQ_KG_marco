+    conf = get("live_confidence")
+    if conf is None:
+        conf = get("confidence")
+    if conf is None and target_type == "circuit_function":
+        conf = get("confidence_score")
+    if conf is None:
+        return None
+    try:
+        return float(conf)
+    except (TypeError, ValueError):
+        return None
