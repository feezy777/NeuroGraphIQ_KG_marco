+def test_list_batch_items_no_n1():
+    """列表读取的 SELECT 次数固定(任务类型 + items + count),不随对象数增长。"""
+    conn_ids: list[str] = []
+    task_id: str | None = None
+    try:
+        async def case():
+            nonlocal task_id
+            async with AsyncSessionLocal() as s:
+                for _ in range(5):
