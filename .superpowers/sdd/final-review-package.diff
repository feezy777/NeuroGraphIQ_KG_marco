+_WORK_ACTIVE_STATUSES = ("searching", "fetching", "retrieving", "extracting", "verifying")
+
+_RAW_STATUS_FALLBACK: dict[str, str] = {
+    "pending": "processing",
+    "running": "processing",
+    "completed": "completed",
+    "failed": "failed",
+    "cancelled": "cancelled",
