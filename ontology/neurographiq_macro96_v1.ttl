# =============================================================================
# NeuroGraphIQ Human Brain Ontology — V1.0 Core Freeze
#
#   Ontology IRI : https://neurographiq.org/ontology/human-brain
#   Namespace    : https://neurographiq.org/ontology/human-brain#   (prefix: ngiq:)
#   Version      : 0.9.0-ontology-core-freeze (Status: draft — awaiting Protégé relation review)
#
# Scope of Gate 6B (incremental over Gate 5B):
#   - 23 core classes (Gate 5B, unchanged).
#   - 23 core ObjectProperties formalized from the Gate 6A relation design:
#       17 canonical + 6 derived / graph-projection.
#   - 3 simple subPropertyOf axioms only:
#       projectsTo           subPropertyOf structurallyConnectedTo
#       hasSourceRegion      subPropertyOf hasEndpointRegion
#       hasTargetRegion      subPropertyOf hasEndpointRegion
#   - owl:unionOf used for:
#       participatesIn  range  = Circuit ∪ Function
#       modulates       domain = Gene ∪ Neurotransmitter
#                       range  = BrainRegion ∪ Circuit ∪ Function
#
# Explicitly absent from V1 (reserved for later gates):
#   - DataProperty / custom AnnotationProperty / Named Individuals / owl:imports
#   - supports / contradicts (deferred to Evidence/Assertion Formalization Gate)
#   - owl:inverseOf / owl:SymmetricProperty / owl:TransitiveProperty /
#     owl:FunctionalProperty / owl:InverseFunctionalProperty /
#     owl:propertyChainAxiom / cardinality restrictions / SHACL
#   - Real BrainRegion / atlas / circuit / connection instance data
#
# Removed from core ontology (per Gate 5A / 5A.1 review):
#   - ConnectionType, CircuitType, EvidenceType, ConnectionAssessment, ConceptDefinition
#   - Governance classes (ConnectionCandidate, CircuitCandidate, EvidenceCandidate,
#     SearchRun, ExtractionRun, ModelReview, HumanReview, InferenceRecord, ValidationRecord)
# =============================================================================

@prefix :     <https://neurographiq.org/ontology/human-brain#> .
@prefix ngiq: <https://neurographiq.org/ontology/human-brain#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://neurographiq.org/ontology/human-brain> a owl:Ontology ;
    rdfs:label "NeuroGraphIQ Human Brain Ontology"@en ;
    rdfs:label "NeuroGraphIQ 人脑知识本体"@zh ;
    rdfs:comment "NeuroGraphIQ Human Brain Core Classes + Core Object Properties. Scope: Homo sapiens (human brain only); mouse, rat, macaque and other species are not modeled as canonical scientific entities in V1. Macro96 is no longer the ontology scope; it serves as a future high-level BrainRegion mapping / aggregation layer. A Class denotes a knowledge type; canonical concepts (e.g. CA1, APOE, Dopamine, PapezCircuit) will be added as Individuals in a later gate. Connection is a canonical entity; direct BrainRegion-to-BrainRegion relations (structurallyConnectedTo / functionallyConnectedTo / projectsTo / effectivelyConnectedTo) are DERIVED graph projections of a Connection entity, not a second canonical truth. BrainRegion hierarchy instances (partOf / subfieldOf) are restricted in production to Homo sapiens (NCBI Taxonomy 9606); no Allen Mouse hierarchy is imported. Status: draft — awaiting Protégé relation review."@en ;
    rdfs:comment "NeuroGraphIQ 人脑知识本体核心类 + 核心对象属性。范围：仅人脑（Homo sapiens）。Macro96 不再是本体范围，而作为未来高层脑区映射/汇总层。Class 表示知识类型；canonical 概念（如 CA1、APOE、Dopamine、PapezCircuit）将在后续 Gate 作为 Individual 加入。Connection 是 canonical 实体；脑区直连关系（structurallyConnectedTo / functionallyConnectedTo / projectsTo / effectivelyConnectedTo）是由 Connection 实体派生的 DERIVED 图投影，不是第二份 canonical truth。BrainRegion hierarchy 实例（partOf / subfieldOf）在生产中仅限 Homo sapiens（NCBI Taxonomy 9606），不导入 Allen Mouse hierarchy。状态：draft — awaiting Protégé relation review。"@zh ;
    owl:versionInfo "0.9.0-ontology-core-freeze" .

# ---------------------------------------------------------------------------
# Core domain classes (direct children of owl:Thing)
# ---------------------------------------------------------------------------

ngiq:BrainRegion a owl:Class ;
    rdfs:label "BrainRegion"@en ;
    rdfs:label "脑区"@zh ;
    rdfs:comment "A distinct region of the human brain with locatable, distinguishable regional identity, defined by macro-anatomy, cytoarchitecture, connectivity, function, or a standard atlas. An activation cluster, network node, or circuit is not itself a BrainRegion. Examples: Hippocampus, CA1."@en ;
    rdfs:comment "在人脑空间中具有可定位、可区分区域身份的解剖或标准脑图谱区域，可依据宏观解剖、细胞构筑、连接、功能或标准图谱定义。单纯的激活簇、网络节点或回路本身不构成脑区。例：海马（Hippocampus）、CA1。"@zh .

ngiq:CellularNeuralStructure a owl:Class ;
    rdfs:label "CellularNeuralStructure"@en ;
    rdfs:label "细胞与亚细胞神经结构"@zh ;
    rdfs:comment "A structural entity of the nervous system at the cellular or subcellular scale. Distinct from BrainRegion. Examples: Neuron, DendriticSpine."@en ;
    rdfs:comment "神经系统细胞或亚细胞尺度的结构实体。不同于脑区（BrainRegion）。例：神经元（Neuron）、树突棘（DendriticSpine）。"@zh .

ngiq:NeurobiologicalProcess a owl:Class ;
    rdfs:label "NeurobiologicalProcess"@en ;
    rdfs:label "神经生物学过程"@zh ;
    rdfs:comment "A biological process occurring in the nervous system. Distinct from CellularNeuralStructure. Examples: SynapticPruning, SynapticPlasticity."@en ;
    rdfs:comment "发生在神经系统中的生物学过程。不同于细胞与亚细胞神经结构。例：突触修剪（SynapticPruning）、突触可塑性（SynapticPlasticity）。"@zh .

ngiq:Connection a owl:Class ;
    rdfs:label "Connection"@en ;
    rdfs:label "连接"@zh ;
    rdfs:comment "An association between two BrainRegions with defined neuroscientific semantics; its specific form may be structural, functional, or effective connectivity. Examples: CA1–mPFC connection, V1–V2 connection."@en ;
    rdfs:comment "两个脑区之间具有明确神经科学语义的连接或关联实体，具体形式可为结构连接、功能连接或有效连接。例：CA1–mPFC 连接、V1–V2 连接。"@zh .

ngiq:Circuit a owl:Class ;
    rdfs:label "Circuit"@en ;
    rdfs:label "神经回路"@zh ;
    rdfs:comment "A neural unit formed by multiple BrainRegions and their organized Connections, with biological, structural, or functional meaning. Not a graph cycle; a general Circuit does not require a closed loop. Examples: Papez circuit, mesolimbic dopamine circuit."@en ;
    rdfs:comment "多个脑区及其有组织的连接形成的、具有生物学、结构或功能意义的神经单元。不是图论环；一般回路不要求闭合环路。例：Papez 回路、中脑边缘多巴胺回路。"@zh .

ngiq:Function a owl:Class ;
    rdfs:label "Function"@en ;
    rdfs:label "功能"@zh ;
    rdfs:comment "A neurobiological function performed by brain regions or circuits; broader than CognitiveFunction. Examples: visual processing, motor control."@en ;
    rdfs:comment "脑区或神经回路参与或承担的神经生物学功能；范围比认知功能更广。例：视觉加工、运动控制。"@zh .

ngiq:Neurotransmitter a owl:Class ;
    rdfs:label "Neurotransmitter"@en ;
    rdfs:label "神经递质"@zh ;
    rdfs:comment "A chemical signaling molecule involved in chemical signal transmission between neural cells. Examples: Dopamine, Glutamate."@en ;
    rdfs:comment "参与神经细胞间化学信号传递的化学信号分子。例：多巴胺（Dopamine）、谷氨酸（Glutamate）。"@zh .

ngiq:Receptor a owl:Class ;
    rdfs:label "Receptor"@en ;
    rdfs:label "受体"@zh ;
    rdfs:comment "A receptor entity that recognizes and responds to neurotransmitters or other signaling molecules; not a Neurotransmitter. Examples: D2 receptor, NMDA receptor."@en ;
    rdfs:comment "能够识别并响应神经递质或其他信号分子的受体实体；受体不是神经递质。例：D2 受体、NMDA 受体。"@zh .

ngiq:Gene a owl:Class ;
    rdfs:label "Gene"@en ;
    rdfs:label "基因"@zh ;
    rdfs:comment "A human gene related to brain structure, function, neurological disease, or other neurobiological processes. Examples: APOE, DISC1."@en ;
    rdfs:comment "与人脑结构、功能、神经系统疾病或其他神经生物学过程相关的人类基因。例：APOE、DISC1。"@zh .

ngiq:Disease a owl:Class ;
    rdfs:label "Disease"@en ;
    rdfs:label "疾病"@zh ;
    rdfs:comment "A neurological disease or psychiatric disorder affecting nervous-system structure, function, or behavior. Distinct from Symptom. Examples: Alzheimer disease, Parkinson disease."@en ;
    rdfs:comment "影响神经系统结构、功能或行为表现的神经系统疾病或精神障碍。不同于症状。例：阿尔茨海默病、帕金森病。"@zh .

ngiq:Symptom a owl:Class ;
    rdfs:label "Symptom"@en ;
    rdfs:label "症状"@zh ;
    rdfs:comment "A clinical manifestation produced by a disease or abnormal state; not a Disease. Examples: Memory impairment, Hallucination."@en ;
    rdfs:comment "疾病或异常状态产生的临床表现；症状不是疾病。例：记忆障碍（Memory impairment）、幻觉（Hallucination）。"@zh .

ngiq:ResearchStudy a owl:Class ;
    rdfs:label "ResearchStudy"@en ;
    rdfs:label "研究"@zh ;
    rdfs:comment "A scientific research, experiment, observation, intervention, or data-analysis activity; distinct from Publication. Examples: an fMRI study, a clinical cohort study."@en ;
    rdfs:comment "一个科学研究、实验、观察、干预或数据分析活动；不同于文献。例：一项 fMRI 研究、一项临床队列研究。"@zh .

ngiq:Publication a owl:Class ;
    rdfs:label "Publication"@en ;
    rdfs:label "文献"@zh ;
    rdfs:comment "A paper or other formal scientific document reporting research results; distinct from Evidence. Examples: a PubMed paper, a journal article."@en ;
    rdfs:comment "报道科学研究结果的论文或其他正式科学文献；不同于证据。例：一篇 PubMed 论文、一篇期刊文章。"@zh .

ngiq:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:label "证据"@zh ;
    rdfs:comment "A concrete scientific evidence unit in a source that supports, refutes, or qualifies a knowledge assertion. Examples: an experiment reporting A projects to B; an fMRI analysis supporting A–B functional connectivity."@en ;
    rdfs:comment "来源中能够支持、反驳或限定某个知识断言的具体科学证据单元。例：论文报道 A 投射到 B 的实验结果；支持 A–B 功能连接的 fMRI 分析。"@zh .

ngiq:Atlas a owl:Class ;
    rdfs:label "Atlas"@en ;
    rdfs:label "脑图谱"@zh ;
    rdfs:comment "A standard brain atlas resource providing spatial parcellation, region definitions, or coordinate reference for the human brain. Examples: Julich-Brain, Brainnetome Atlas."@en ;
    rdfs:comment "提供人脑空间划分、区域定义或坐标参考的标准脑图谱资源。例：Julich-Brain、Brainnetome Atlas。"@zh .

ngiq:ExternalRegion a owl:Class ;
    rdfs:label "ExternalRegion"@en ;
    rdfs:label "外部脑区"@zh ;
    rdfs:comment "A brain region defined by an external atlas, ontology, or terminology, not yet canonicalized in NeuroGraphIQ; distinct from canonical BrainRegion. Examples: a Julich-Brain parcel, a Brainnetome parcel."@en ;
    rdfs:comment "由外部图谱、本体或术语定义、尚未完成 NeuroGraphIQ canonicalization 的脑区概念；不同于 canonical 脑区。例：某 Julich-Brain parcel、某 Brainnetome parcel。"@zh .

ngiq:RegionMapping a owl:Class ;
    rdfs:label "RegionMapping"@en ;
    rdfs:label "脑区映射"@zh ;
    rdfs:comment "A mapping entity recording the correspondence between an ExternalRegion and a canonical BrainRegion. Example: Brainnetome region X → canonical mPFC."@en ;
    rdfs:comment "记录外部脑区与 NeuroGraphIQ canonical 脑区之间对应关系的映射实体。例：Brainnetome region X → canonical mPFC。"@zh .

ngiq:CircuitConnectionMembership a owl:Class ;
    rdfs:label "CircuitConnectionMembership"@en ;
    rdfs:label "回路连接成员关系"@zh ;
    rdfs:comment "An association entity representing the membership and context of a Connection within a Circuit; may later carry step_order, role, membership evidence. Example: Connection C001 is step 2 in Circuit A and step 5 in Circuit B."@en ;
    rdfs:comment "表示某一连接在某一回路中的成员身份与上下文的关联实体；未来可承载 step_order、role、membership evidence。例：Connection C001 在 Circuit A 中是第 2 步、在 Circuit B 中是第 5 步。"@zh .

# ---------------------------------------------------------------------------
# Connection hierarchy (Gate 2 scientific semantics preserved; subtype model)
# ---------------------------------------------------------------------------

ngiq:StructuralConnection a owl:Class ;
    rdfs:subClassOf ngiq:Connection ;
    rdfs:label "StructuralConnection"@en ;
    rdfs:label "结构连接"@zh ;
    rdfs:comment "A Connection asserting a physical / neuroanatomical pathway between two BrainRegions. Examples: corticocortical anatomical connection, thalamocortical structural connection."@en ;
    rdfs:comment "两个脑区之间存在物理/神经解剖结构通路的连接。例：皮层-皮层解剖连接、丘脑-皮层结构连接。"@zh .

ngiq:Projection a owl:Class ;
    rdfs:subClassOf ngiq:StructuralConnection ;
    rdfs:label "Projection"@en ;
    rdfs:label "投射"@zh ;
    rdfs:comment "A StructuralConnection with definite source→target and axonal projection semantics. DTI tractography alone cannot determine projection direction. Examples: CA1 projects to mPFC, thalamus projects to cortex."@en ;
    rdfs:comment "具有明确 source→target 和轴突投射语义的结构连接。仅凭 DTI 纤维追踪不能确定投射方向。例：CA1 投射到 mPFC、丘脑投射到皮层。"@zh .

ngiq:FunctionalConnectivity a owl:Class ;
    rdfs:subClassOf ngiq:Connection ;
    rdfs:label "FunctionalConnectivity"@en ;
    rdfs:label "功能连接"@zh ;
    rdfs:comment "A Connection expressing statistical dependence, correlation, or temporal synchrony between the neural activity of two BrainRegions; it does not imply a StructuralConnection. Example: resting-state fMRI correlation between PCC and mPFC."@en ;
    rdfs:comment "两个脑区神经活动之间的统计依赖、相关或时间同步关系；不自动意味着结构连接。例：PCC 与 mPFC 的静息态 fMRI 相关。"@zh .

ngiq:EffectiveConnectivity a owl:Class ;
    rdfs:subClassOf ngiq:Connection ;
    rdfs:label "EffectiveConnectivity"@en ;
    rdfs:label "有效连接"@zh ;
    rdfs:comment "A Connection expressing directed influence or causal coupling between BrainRegions inferred within a model or experiment; causal interpretation depends on method, model, and design. Example: DCM-estimated A→B influence."@en ;
    rdfs:comment "基于模型或实验推断的脑区之间有向影响或作用关系；因果解释依赖方法、模型和实验设计。例：DCM 估计的 A→B 影响。"@zh .

# ---------------------------------------------------------------------------
# Function hierarchy
# ---------------------------------------------------------------------------

ngiq:CognitiveFunction a owl:Class ;
    rdfs:subClassOf ngiq:Function ;
    rdfs:label "CognitiveFunction"@en ;
    rdfs:label "认知功能"@zh ;
    rdfs:comment "A Function related to cognition. Examples: WorkingMemory, Language."@en ;
    rdfs:comment "与认知活动相关的功能。例：工作记忆（WorkingMemory）、语言（Language）。"@zh .

# ---------------------------------------------------------------------------
# Object properties
# ---------------------------------------------------------------------------
# A. BrainRegion direct / derived relations (graph projection of Connection entity)
# ---------------------------------------------------------------------------

ngiq:structurallyConnectedTo a owl:ObjectProperty ;
    rdfs:label "structurallyConnectedTo"@en ;
    rdfs:label "结构连接"@zh ;
    rdfs:domain ngiq:BrainRegion ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "A direct relation between two BrainRegions expressing a physical neuroanatomical pathway; direction may be directed, reciprocal, or unknown. Representation: DERIVED / GRAPH PROJECTION of a StructuralConnection entity. Example: Thalamus structurallyConnectedTo Cortex."@en ;
    rdfs:comment "两个脑区之间存在神经解剖物理通路的直连关系；方向可为 directed / reciprocal / unknown。Representation：DERIVED / GRAPH PROJECTION（由 StructuralConnection 实体派生）。例：Thalamus structurallyConnectedTo Cortex。"@zh .

ngiq:functionallyConnectedTo a owl:ObjectProperty ;
    rdfs:label "functionallyConnectedTo"@en ;
    rdfs:label "功能连接"@zh ;
    rdfs:domain ngiq:BrainRegion ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "A direct relation between two BrainRegions expressing statistical dependence, correlation, or temporal synchrony of their neural activity; V1 non-directional. Representation: DERIVED / GRAPH PROJECTION of a FunctionalConnectivity entity. Example: PCC functionallyConnectedTo mPFC."@en ;
    rdfs:comment "两个脑区的神经活动之间存在统计依赖、相关或同步关系的直连关系；V1 默认 non-directional。Representation：DERIVED / GRAPH PROJECTION（由 FunctionalConnectivity 实体派生）。例：PCC functionallyConnectedTo mPFC。"@zh .

ngiq:projectsTo a owl:ObjectProperty ;
    rdfs:subPropertyOf ngiq:structurallyConnectedTo ;
    rdfs:label "projectsTo"@en ;
    rdfs:label "投射到"@zh ;
    rdfs:domain ngiq:BrainRegion ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "A directed relation expressing a definite source→target axonal projection between two BrainRegions. DTI/tractography alone cannot determine this direction. Representation: DERIVED / GRAPH PROJECTION of a Projection entity. Example: CA1 projectsTo mPFC."@en ;
    rdfs:comment "一个脑区向另一个脑区发出明确 source→target 轴突投射的有向关系；仅凭 DTI 纤维追踪不能确定方向。Representation：DERIVED / GRAPH PROJECTION（由 Projection 实体派生）。例：CA1 projectsTo mPFC。"@zh .

ngiq:effectivelyConnectedTo a owl:ObjectProperty ;
    rdfs:label "effectivelyConnectedTo"@en ;
    rdfs:label "有效连接"@zh ;
    rdfs:domain ngiq:BrainRegion ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "A directed relation expressing a model/experiment-inferred influence of one BrainRegion on another; distinct from projectsTo. Representation: DERIVED / GRAPH PROJECTION of an EffectiveConnectivity entity. Example: A effectivelyConnectedTo B (DCM)."@en ;
    rdfs:comment "通过模型、实验设计或干预分析推断的一个脑区对另一个脑区的有向影响；不同于 projectsTo。Representation：DERIVED / GRAPH PROJECTION（由 EffectiveConnectivity 实体派生）。例：A effectivelyConnectedTo B（DCM）。"@zh .

ngiq:participatesIn a owl:ObjectProperty ;
    rdfs:label "participatesIn"@en ;
    rdfs:label "参与"@zh ;
    rdfs:domain ngiq:BrainRegion ;
    rdfs:range [ owl:unionOf ( ngiq:Circuit ngiq:Function ) ] ;
    rdfs:comment "A BrainRegion participates in a Circuit or a Function. Representation: CANONICAL. Example: Hippocampus participatesIn PapezCircuit; PrefrontalCortex participatesIn WorkingMemory."@en ;
    rdfs:comment "某脑区参与某神经回路（Circuit）或神经功能（Function）。Representation：CANONICAL。例：Hippocampus participatesIn PapezCircuit；PrefrontalCortex participatesIn WorkingMemory。"@zh .

ngiq:modulates a owl:ObjectProperty ;
    rdfs:label "modulates"@en ;
    rdfs:label "调控"@zh ;
    rdfs:domain [ owl:unionOf ( ngiq:Gene ngiq:Neurotransmitter ) ] ;
    rdfs:range [ owl:unionOf ( ngiq:BrainRegion ngiq:Circuit ngiq:Function ) ] ;
    rdfs:comment "A Gene or Neurotransmitter has an evidence-supported modulatory effect on a BrainRegion, Circuit, or Function; distinct from associatedWith and causes. Representation: CANONICAL. Example: Dopamine modulates RewardFunction."@en ;
    rdfs:comment "某基因或神经递质对脑区、回路或功能产生有证据支持的调节作用；不同于 associatedWith 与 causes。Representation：CANONICAL。例：Dopamine modulates RewardFunction。"@zh .

ngiq:increasesRiskOf a owl:ObjectProperty ;
    rdfs:label "increasesRiskOf"@en ;
    rdfs:label "增加风险"@zh ;
    rdfs:domain ngiq:Gene ;
    rdfs:range ngiq:Disease ;
    rdfs:comment "A Gene has an evidence-supported risk relationship with a Disease; distinct from causes. Representation: CANONICAL. Example: APOE increasesRiskOf AlzheimerDisease (allele/variant-level risk, e.g. APOE ε4, requires a future GeneticVariant/Allele model)."@en ;
    rdfs:comment "某基因与某疾病风险增加之间存在有证据支持的风险关系；不同于 causes。Representation：CANONICAL。例：APOE increasesRiskOf AlzheimerDisease（APOE ε4 等 allele/variant 级风险关系需未来 GeneticVariant/Allele 模型）。"@zh .

ngiq:hasFunction a owl:ObjectProperty ;
    rdfs:label "hasFunction"@en ;
    rdfs:label "具有功能"@zh ;
    rdfs:domain ngiq:Circuit ;
    rdfs:range ngiq:Function ;
    rdfs:comment "A Circuit has an explicit functional association with a Function. BrainRegion-to-Function uses participatesIn, not hasFunction. Representation: CANONICAL. Example: PapezCircuit hasFunction MemoryRelatedFunction."@en ;
    rdfs:comment "某回路与某项神经功能存在明确功能关联。脑区到功能的关联用 participatesIn 而非 hasFunction。Representation：CANONICAL。例：PapezCircuit hasFunction MemoryRelatedFunction。"@zh .

ngiq:hasSymptom a owl:ObjectProperty ;
    rdfs:label "hasSymptom"@en ;
    rdfs:label "具有症状"@zh ;
    rdfs:domain ngiq:Disease ;
    rdfs:range ngiq:Symptom ;
    rdfs:comment "A Disease has or may present a Symptom; not that every patient necessarily presents it. Representation: CANONICAL. Example: AlzheimerDisease hasSymptom MemoryImpairment."@en ;
    rdfs:comment "某疾病具有或可能表现某临床症状；并非所有患者必然出现该症状。Representation：CANONICAL。例：AlzheimerDisease hasSymptom MemoryImpairment。"@zh .

ngiq:actsOn a owl:ObjectProperty ;
    rdfs:label "actsOn"@en ;
    rdfs:label "作用于"@zh ;
    rdfs:domain ngiq:Neurotransmitter ;
    rdfs:range ngiq:Receptor ;
    rdfs:comment "A Neurotransmitter acts on a Receptor. Representation: CANONICAL. Example: Dopamine actsOn D2Receptor."@en ;
    rdfs:comment "某神经递质作用于某受体。Representation：CANONICAL。例：Dopamine actsOn D2Receptor。"@zh .

# ---------------------------------------------------------------------------
# B. Connection structural properties
# ---------------------------------------------------------------------------

ngiq:hasEndpointRegion a owl:ObjectProperty ;
    rdfs:label "hasEndpointRegion"@en ;
    rdfs:label "连接端点脑区"@zh ;
    rdfs:domain ngiq:Connection ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "A Connection involves a BrainRegion endpoint; does not assert direction. Used for FunctionalConnectivity and direction-unknown StructuralConnection. Representation: CANONICAL. Example: FC001 hasEndpointRegion PCC; FC001 hasEndpointRegion mPFC."@en ;
    rdfs:comment "某 Connection 涉及的脑区端点，不声明方向。用于 FunctionalConnectivity 与 direction-unknown StructuralConnection。Representation：CANONICAL。例：FC001 hasEndpointRegion PCC；FC001 hasEndpointRegion mPFC。"@zh .

ngiq:hasSourceRegion a owl:ObjectProperty ;
    rdfs:subPropertyOf ngiq:hasEndpointRegion ;
    rdfs:label "hasSourceRegion"@en ;
    rdfs:label "起始脑区"@zh ;
    rdfs:domain ngiq:Connection ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "The true source BrainRegion of a Connection when direction is scientifically established. Representation: CANONICAL. Example: CONN_001 (rdf:type Projection) hasSourceRegion CA1."@en ;
    rdfs:comment "方向科学上已知时，Connection 的真实起始脑区。Representation：CANONICAL。例：CONN_001（rdf:type Projection）hasSourceRegion CA1。"@zh .

ngiq:hasTargetRegion a owl:ObjectProperty ;
    rdfs:subPropertyOf ngiq:hasEndpointRegion ;
    rdfs:label "hasTargetRegion"@en ;
    rdfs:label "目标脑区"@zh ;
    rdfs:domain ngiq:Connection ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "The true target BrainRegion of a Connection when direction is scientifically established. Representation: CANONICAL. Example: CONN_001 hasTargetRegion mPFC."@en ;
    rdfs:comment "方向科学上已知时，Connection 的真实目标脑区。Representation：CANONICAL。例：CONN_001 hasTargetRegion mPFC。"@zh .

# ---------------------------------------------------------------------------
# C. Circuit properties
# ---------------------------------------------------------------------------

ngiq:includesRegion a owl:ObjectProperty ;
    rdfs:label "includesRegion"@en ;
    rdfs:label "包含脑区"@zh ;
    rdfs:domain ngiq:Circuit ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "A BrainRegion is a constituent of a Circuit. Inverse candidate of participatesIn (when participatesIn targets a Circuit); no owl:inverseOf in this gate. Representation: CANONICAL. Example: PapezCircuit includesRegion Hippocampus."@en ;
    rdfs:comment "某 BrainRegion 是某 Circuit 的组成脑区之一。与 participatesIn（target 为 Circuit 时）具自然逆语义；本 Gate 不设 owl:inverseOf。Representation：CANONICAL。例：PapezCircuit includesRegion Hippocampus。"@zh .

ngiq:hasConnectionMembership a owl:ObjectProperty ;
    rdfs:label "hasConnectionMembership"@en ;
    rdfs:label "具有连接成员关系"@zh ;
    rdfs:domain ngiq:Circuit ;
    rdfs:range ngiq:CircuitConnectionMembership ;
    rdfs:comment "A Circuit has a CircuitConnectionMembership (reified membership of a Connection within the Circuit). Representation: CANONICAL."@en ;
    rdfs:comment "某回路拥有某连接成员关系（Connection 在 Circuit 中的 reified membership）。Representation：CANONICAL。"@zh .

ngiq:membershipConnection a owl:ObjectProperty ;
    rdfs:label "membershipConnection"@en ;
    rdfs:label "成员连接"@zh ;
    rdfs:domain ngiq:CircuitConnectionMembership ;
    rdfs:range ngiq:Connection ;
    rdfs:comment "A CircuitConnectionMembership refers to its Connection. The membership entity may later carry step_order, role, membership evidence, topology context. Representation: CANONICAL."@en ;
    rdfs:comment "某连接成员关系指向其 Connection。成员关系实体未来可承载 step_order、role、membership evidence、topology context。Representation：CANONICAL。"@zh .

ngiq:hasConnection a owl:ObjectProperty ;
    rdfs:label "hasConnection"@en ;
    rdfs:label "包含连接"@zh ;
    rdfs:domain ngiq:Circuit ;
    rdfs:range ngiq:Connection ;
    rdfs:comment "A Circuit contains a Connection; derived convenience relation of the hasConnectionMembership + membershipConnection chain. Representation: DERIVED / CONVENIENCE (canonical source: Circuit → hasConnectionMembership → CircuitConnectionMembership → membershipConnection → Connection)."@en ;
    rdfs:comment "某回路包含某连接；由 hasConnectionMembership + membershipConnection 链派生的便捷关系。Representation：DERIVED / CONVENIENCE（canonical 来源：Circuit → hasConnectionMembership → CircuitConnectionMembership → membershipConnection → Connection）。"@zh .

# ---------------------------------------------------------------------------
# D. Evidence / provenance properties
# ---------------------------------------------------------------------------

ngiq:reportedIn a owl:ObjectProperty ;
    rdfs:label "reportedIn"@en ;
    rdfs:label "报道于"@zh ;
    rdfs:domain ngiq:ResearchStudy ;
    rdfs:range ngiq:Publication ;
    rdfs:comment "A ResearchStudy's results are reported by a Publication. Representation: CANONICAL. Example: Study S001 reportedIn PMID_xxx."@en ;
    rdfs:comment "一项研究的结果由某文献报道。Representation：CANONICAL。例：Study S001 reportedIn PMID_xxx。"@zh .

ngiq:providesEvidence a owl:ObjectProperty ;
    rdfs:label "providesEvidence"@en ;
    rdfs:label "提供证据"@zh ;
    rdfs:domain ngiq:Publication ;
    rdfs:range ngiq:Evidence ;
    rdfs:comment "A Publication provides a concrete Evidence unit. Representation: CANONICAL."@en ;
    rdfs:comment "某文献提供一个具体证据单元。Representation：CANONICAL。"@zh .

# ---------------------------------------------------------------------------
# E. Atlas / mapping properties
# ---------------------------------------------------------------------------

ngiq:definedInAtlas a owl:ObjectProperty ;
    rdfs:label "definedInAtlas"@en ;
    rdfs:label "定义于图谱"@zh ;
    rdfs:domain ngiq:ExternalRegion ;
    rdfs:range ngiq:Atlas ;
    rdfs:comment "An ExternalRegion is sourced from or defined by an Atlas. Representation: CANONICAL. Example: Brainnetome parcel A9m definedInAtlas BrainnetomeAtlas."@en ;
    rdfs:comment "某外部脑区来源或定义于某图谱。Representation：CANONICAL。例：Brainnetome parcel A9m definedInAtlas BrainnetomeAtlas。"@zh .

ngiq:mappingSource a owl:ObjectProperty ;
    rdfs:label "mappingSource"@en ;
    rdfs:label "映射源"@zh ;
    rdfs:domain ngiq:RegionMapping ;
    rdfs:range ngiq:ExternalRegion ;
    rdfs:comment "The source ExternalRegion of a RegionMapping. Representation: CANONICAL."@en ;
    rdfs:comment "某脑区映射的源外部脑区。Representation：CANONICAL。"@zh .

ngiq:mappingTarget a owl:ObjectProperty ;
    rdfs:label "mappingTarget"@en ;
    rdfs:label "映射目标"@zh ;
    rdfs:domain ngiq:RegionMapping ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "The target canonical BrainRegion of a RegionMapping. Representation: CANONICAL."@en ;
    rdfs:comment "某脑区映射的目标 canonical 脑区。Representation：CANONICAL。"@zh .

ngiq:mapsTo a owl:ObjectProperty ;
    rdfs:label "mapsTo"@en ;
    rdfs:label "映射到"@zh ;
    rdfs:domain ngiq:ExternalRegion ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "An ExternalRegion maps to a canonical BrainRegion; derived convenience relation of the RegionMapping reification. Representation: DERIVED / CONVENIENCE (canonical source: RegionMapping → mappingSource → ExternalRegion; RegionMapping → mappingTarget → BrainRegion)."@en ;
    rdfs:comment "某外部脑区映射到 canonical 脑区；由 RegionMapping reification 派生的便捷关系。Representation：DERIVED / CONVENIENCE（canonical 来源：RegionMapping → mappingSource → ExternalRegion；RegionMapping → mappingTarget → BrainRegion）。"@zh .

# ---------------------------------------------------------------------------
# BrainRegion anatomical hierarchy (Gate 6C)
# ---------------------------------------------------------------------------

ngiq:partOf a owl:ObjectProperty ;
    rdfs:label "part of"@en ;
    rdfs:label "属于"@zh ;
    rdfs:domain ngiq:BrainRegion ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "A canonical human BrainRegion is an anatomical constituent part of a higher-level BrainRegion in the canonical anatomical hierarchy. Not overlap, not atlas mapping, not cross-granularity approximate aggregation, not functional participation. Representation: CANONICAL. Example: Hippocampus partOf MedialTemporalRegion."@en ;
    rdfs:comment "一个 canonical 人脑区在解剖组成或 canonical anatomical hierarchy 中构成另一个更高层脑区的一部分。不表示 overlap、atlas mapping、跨颗粒度近似聚合或功能参与。Representation：CANONICAL。例：Hippocampus partOf MedialTemporalRegion。"@zh .

ngiq:subfieldOf a owl:ObjectProperty ;
    rdfs:subPropertyOf ngiq:partOf ;
    rdfs:label "subfield of"@en ;
    rdfs:label "亚区属于"@zh ;
    rdfs:domain ngiq:BrainRegion ;
    rdfs:range ngiq:BrainRegion ;
    rdfs:comment "A BrainRegion is a clearly delineated anatomical subfield of a larger BrainRegion; a more specific form of partOf. Example: CA1 subfieldOf Hippocampus (implies CA1 partOf Hippocampus)."@en ;
    rdfs:comment "一个脑区是另一个较大脑区具有明确解剖学意义的细分亚区；是 partOf 的更具体形式。例：CA1 subfieldOf Hippocampus（可推出 CA1 partOf Hippocampus）。"@zh .

# ---------------------------------------------------------------------------
# Function hierarchy (Gate 6D)
# ---------------------------------------------------------------------------

ngiq:subFunctionOf a owl:ObjectProperty ;
    rdfs:label "subfunction of"@en ;
    rdfs:label "是……的下位功能"@zh ;
    rdfs:domain ngiq:Function ;
    rdfs:range ngiq:Function ;
    rdfs:comment "Relates a canonical Function concept to a broader Function concept when the former represents a more specific functional category or specialization of the latter. This is ABox semantic hierarchy, NOT rdfs:subClassOf (WorkingMemory / Memory are canonical Function Individuals, not OWL Classes). Representation: CANONICAL. Example: WorkingMemory subFunctionOf Memory; SelectiveAttention subFunctionOf Attention."@en ;
    rdfs:comment "一个 canonical Function 概念是另一个更宽泛 Function 概念的更具体功能类别或功能特化。这是 ABox semantic hierarchy，不是 rdfs:subClassOf（WorkingMemory / Memory 是 canonical Function Individual，非 OWL Class）。Representation：CANONICAL。例：WorkingMemory subFunctionOf Memory；SelectiveAttention subFunctionOf Attention。"@zh .
