# =============================================================================
# NeuroGraphIQ Macro96 Ontology — V1.0 Gate 2B
#
#   Ontology IRI : https://neurographiq.org/ontology/macro96
#   Namespace    : https://neurographiq.org/ontology/macro96#   (prefix: ngiq:)
#   Version      : 0.2.0-gate2b (Status: draft — for human review in Protégé)
#
# Scope of Gate 2B (incremental over Gate 1):
#   - Gate 1: ontology declaration + namespace/prefix + version metadata
#             + 24 top-level classes with English/Chinese labels and short comments
#   - Gate 2B: ConnectionType sub-hierarchy (4 classes, frozen by Gate 2A review):
#             StructuralConnection, Projection, FunctionalConnectivity,
#             EffectiveConnectivity
#
# Explicitly absent (reserved for later gates):
#   - ObjectProperty / DataProperty / custom AnnotationProperty
#   - CircuitType / EvidenceType sub-hierarchies
#   - Function hierarchy, BrainRegion hierarchy, SHACL constraints
#   - Individuals, Macro96 BrainRegion instances, ConnectionAssessment instances
#   - HBAO / Uberon / NeuroNames mapping
#   - owl:imports (must remain empty)
# =============================================================================

@prefix :     <https://neurographiq.org/ontology/macro96#> .
@prefix ngiq: <https://neurographiq.org/ontology/macro96#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://neurographiq.org/ontology/macro96> a owl:Ontology ;
    rdfs:label "NeuroGraphIQ Macro96 Ontology"@en ;
    rdfs:label "NeuroGraphIQ Macro96 本体"@zh ;
    rdfs:comment "Concept skeleton of the NeuroGraphIQ Macro96 knowledge-production ontology. Status: draft. Gate 2B scope: ontology metadata, 24 top-level classes, and the ConnectionType sub-hierarchy (4 classes)."@en ;
    owl:versionInfo "0.2.0-gate2b" .

# ---------------------------------------------------------------------------
# Gate 1 — 24 top-level classes (direct children of owl:Thing)
# ---------------------------------------------------------------------------

ngiq:BrainRegion a owl:Class ;
    rdfs:label "BrainRegion"@en ;
    rdfs:label "脑区"@zh ;
    rdfs:comment "A distinct region of the brain; the core anchor concept of the Macro96 system."@en .

ngiq:Function a owl:Class ;
    rdfs:label "Function"@en ;
    rdfs:label "功能"@zh ;
    rdfs:comment "A biological or cognitive function performed by brain regions or circuits."@en .

ngiq:Connection a owl:Class ;
    rdfs:label "Connection"@en ;
    rdfs:label "连接"@zh ;
    rdfs:comment "A promoted, canonical connection between two brain regions."@en .

ngiq:ConnectionType a owl:Class ;
    rdfs:label "ConnectionType"@en ;
    rdfs:label "连接类型"@zh ;
    rdfs:comment "Controlled-vocabulary class for connection types (hierarchy defined in Gate 2)."@en .

ngiq:Circuit a owl:Class ;
    rdfs:label "Circuit"@en ;
    rdfs:label "回路"@zh ;
    rdfs:comment "A promoted, canonical circuit composed of regions and their connections."@en .

ngiq:CircuitType a owl:Class ;
    rdfs:label "CircuitType"@en ;
    rdfs:label "回路类型"@zh ;
    rdfs:comment "Controlled-vocabulary class for circuit types (hierarchy defined in Gate 3)."@en .

ngiq:CircuitConnectionMembership a owl:Class ;
    rdfs:label "CircuitConnectionMembership"@en ;
    rdfs:label "回路连接成员关系"@zh ;
    rdfs:comment "Membership of a Connection within a Circuit."@en .

ngiq:Publication a owl:Class ;
    rdfs:label "Publication"@en ;
    rdfs:label "文献"@zh ;
    rdfs:comment "A scientific paper or other literature source used in knowledge production."@en .

ngiq:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:label "证据"@zh ;
    rdfs:comment "A promoted piece of evidence supporting a connection or circuit claim."@en .

ngiq:EvidenceType a owl:Class ;
    rdfs:label "EvidenceType"@en ;
    rdfs:label "证据类型"@zh ;
    rdfs:comment "Controlled-vocabulary class for evidence types (hierarchy defined in a later gate)."@en .

ngiq:Atlas a owl:Class ;
    rdfs:label "Atlas"@en ;
    rdfs:label "脑图谱"@zh ;
    rdfs:comment "A brain atlas providing parcellation and/or spatial coordinates."@en .

ngiq:ExternalRegion a owl:Class ;
    rdfs:label "ExternalRegion"@en ;
    rdfs:label "外部脑区"@zh ;
    rdfs:comment "A brain region defined by an external source (atlas or terminology), prior to canonical mapping."@en .

ngiq:RegionMapping a owl:Class ;
    rdfs:label "RegionMapping"@en ;
    rdfs:label "脑区映射"@zh ;
    rdfs:comment "A mapping between an ExternalRegion and a canonical BrainRegion."@en .

ngiq:ConnectionAssessment a owl:Class ;
    rdfs:label "ConnectionAssessment"@en ;
    rdfs:label "连接评估"@zh ;
    rdfs:comment "An assessment run over a pair of brain regions for a possible connection."@en .

ngiq:ConnectionCandidate a owl:Class ;
    rdfs:label "ConnectionCandidate"@en ;
    rdfs:label "连接候选"@zh ;
    rdfs:comment "A proposed connection awaiting validation, review and promotion."@en .

ngiq:CircuitCandidate a owl:Class ;
    rdfs:label "CircuitCandidate"@en ;
    rdfs:label "回路候选"@zh ;
    rdfs:comment "A proposed circuit awaiting validation, review and promotion."@en .

ngiq:EvidenceCandidate a owl:Class ;
    rdfs:label "EvidenceCandidate"@en ;
    rdfs:label "证据候选"@zh ;
    rdfs:comment "A candidate piece of evidence awaiting model and human review."@en .

ngiq:SearchRun a owl:Class ;
    rdfs:label "SearchRun"@en ;
    rdfs:label "检索运行"@zh ;
    rdfs:comment "A literature search run over publication sources."@en .

ngiq:ExtractionRun a owl:Class ;
    rdfs:label "ExtractionRun"@en ;
    rdfs:label "抽取运行"@zh ;
    rdfs:comment "An LLM extraction run over publications."@en .

ngiq:ModelReview a owl:Class ;
    rdfs:label "ModelReview"@en ;
    rdfs:label "模型审核"@zh ;
    rdfs:comment "An automated model review of a candidate."@en .

ngiq:HumanReview a owl:Class ;
    rdfs:label "HumanReview"@en ;
    rdfs:label "人工审核"@zh ;
    rdfs:comment "A human review of a candidate."@en .

ngiq:InferenceRecord a owl:Class ;
    rdfs:label "InferenceRecord"@en ;
    rdfs:label "推断记录"@zh ;
    rdfs:comment "A record of an inference made during knowledge production."@en .

ngiq:ValidationRecord a owl:Class ;
    rdfs:label "ValidationRecord"@en ;
    rdfs:label "验证记录"@zh ;
    rdfs:comment "A record of a validation decision or rule check."@en .

ngiq:ConceptDefinition a owl:Class ;
    rdfs:label "ConceptDefinition"@en ;
    rdfs:label "概念定义"@zh ;
    rdfs:comment "A definition of a concept used by the ontology."@en .

# ---------------------------------------------------------------------------
# Gate 2B — ConnectionType sub-hierarchy (4 classes, frozen by Gate 2A review)
# ---------------------------------------------------------------------------

ngiq:StructuralConnection a owl:Class ;
    rdfs:subClassOf ngiq:ConnectionType ;
    rdfs:label "Structural Connection"@en ;
    rdfs:label "结构连接"@zh ;
    rdfs:comment "Structural Connection (alternative term: anatomical connection). A structural, physical neuroanatomical pathway between two brain regions. It asserts only the existence of a physical pathway; it is NOT equivalent to functional statistical correlation, nor to model-inferred directed influence. Direction may be directed, reciprocal, or direction_unknown. Current evidence may be insufficient to confirm synaptic-level directness; a polysynaptic / indirect pathway mediated by intermediate regions must not be collapsed into a single StructuralConnection and should be expressed via Path / Circuit / Inference."@en ;
    rdfs:comment "结构连接（替代术语：解剖连接 anatomical connection）。两个脑区之间存在结构性、物理性的神经解剖通路。它仅断言物理通路的存在；不等于功能统计相关，也不等于模型推断的有向影响。方向可以是 directed / reciprocal / direction_unknown。当前证据可能不足以确认突触级 directness；由多个中间脑区介导的 polysynaptic / indirect pathway 不能压缩为单条 StructuralConnection，应由 Path / Circuit / Inference 表达。"@zh .

ngiq:Projection a owl:Class ;
    rdfs:subClassOf ngiq:StructuralConnection ;
    rdfs:label "Projection"@en ;
    rdfs:label "投射"@zh ;
    rdfs:comment "Projection. A StructuralConnection with a definite source->target and axonal projection semantics/evidence (e.g., axons from A terminate in B; afferents to B originate from A). Being directed is necessary but not sufficient: direction_known alone does not imply Projection; axonal projection semantics/evidence is also required. DTI tractography alone cannot determine the A->B projection direction."@en ;
    rdfs:comment "投射。具有明确 source→target 且具有 axonal projection 语义/证据的 StructuralConnection 子类（如：A 的轴突终止于 B；B 的传入源自 A）。direction_known 是必要条件但不是充分条件，仍需 axonal projection semantics/evidence。DTI tractography 不能单独确定 A→B 投射方向。"@zh .

ngiq:FunctionalConnectivity a owl:Class ;
    rdfs:subClassOf ngiq:ConnectionType ;
    rdfs:label "Functional Connectivity"@en ;
    rdfs:label "功能连接"@zh ;
    rdfs:comment "Functional Connectivity. A statistical dependence or temporal correlation between the neural activities of two brain regions. In V1 it is modelled as non-directional by default. It does NOT imply a StructuralConnection. fMRI / EEG / MEG are evidence/measurement modalities, not connection types. Coactivation cannot by itself be promoted automatically to FunctionalConnectivity."@en ;
    rdfs:comment "功能连接。两个脑区神经活动之间存在统计依赖或时间相关关系。V1 默认建模为 non-directional。不隐含 StructuralConnection。fMRI / EEG / MEG 是证据/测量模态，不是 ConnectionType。Coactivation 不能仅凭自身自动晋升为 FunctionalConnectivity。"@zh .

ngiq:EffectiveConnectivity a owl:Class ;
    rdfs:subClassOf ngiq:ConnectionType ;
    rdfs:label "Effective Connectivity"@en ;
    rdfs:label "有效连接"@zh ;
    rdfs:comment "Effective Connectivity. A model-dependent directed influence / directed coupling of one neural system on another, within a model or experimental framework. The causal interpretation depends on the specific method, model assumptions and experimental design. EffectiveConnectivity is NOT equivalent to Projection, nor to StructuralConnection, unless independent structural evidence exists."@en ;
    rdfs:comment "有效连接。在模型或实验框架下，一个神经系统对另一个神经系统的 model-dependent directed influence / directed coupling。causal interpretation 取决于具体方法、模型假设和实验设计。EffectiveConnectivity ≠ Projection，也 ≠ StructuralConnection，除非另有独立结构证据。"@zh .
